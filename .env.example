# Copy this file to `.env` and fill in real values.
# `habit_tracker.settings` reads it from the backend directory on startup.

# --- Core -----------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
# Comma separated, no spaces.
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database -------------------------------------------------------------
# Django engine path, e.g. django.db.backends.postgresql or django_mongodb_backend
DB_ENGINE=django.db.backends.postgresql
DB_NAME=habit_tracker
DB_USER=habit_tracker
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Frontend -------------------------------------------------------------
# Browser-facing origin. Used to build the password reset link that goes out by
# email, so it must be the URL the browser reaches, not the Django host.
FRONTEND_URL=http://localhost:3000

# --- Email (password reset) ----------------------------------------------
# Reset links are delivered with these settings, so point them at a real SMTP
# server. The console backend only prints the message to the server log, and the
# link it prints is quoted-printable, so a uid/token copied out of the log is
# already corrupt. For local work it can be opted into explicitly with
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Habit Tracker <no-reply@habittracker.local>
# Seconds a reset link stays valid. Default is 24 hours.
PASSWORD_RESET_TIMEOUT=86400

# --- Google sign in -------------------------------------------------------
# Leave blank to boot without Google sign in. All four must be set for the
# feature to be enabled (GOOGLE_OAUTH_ENABLED is derived from them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/user/auth/google/callback/
GOOGLE_LOGIN_SUCCESS_URL=http://localhost:3000/auth/google/callback

# Whether a Google login may adopt an existing account with the same email.
GOOGLE_LINK_EXISTING_ACCOUNTS=True
